# Application
APP_ENV=development
HTTP_PORT=8888
SKIP_AUTO_MIGRATE=false

# Logging
# Default: <project-root>/logs
LOG_DIR=

# Database (postgres | mysql)
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=finance
DB_PASSWORD=finance
DB_NAME=finance
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Auth (single admin user)
AUTH_USERNAME=admin
# Use bcrypt hash, e.g. from `openssl passwd -6` won't work; use `htpasswd -nbBC 10 "" "yourpass" | tr -d ':\n'`
AUTH_PASSWORD_HASH=
AUTH_JWT_SECRET=please-change

# AI parsing (DeepSeek official API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
AI_USE_ENV_PROXY=true

# football-data.org
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC
FOOTBALL_WORLD_CUP_SEASON=2026

# FIFA official public rankings API. Leave SCHEDULE_ID empty to use live ranking.
FIFA_RANKING_BASE_URL=https://api.fifa.com/api/v3
FIFA_RANKING_SCHEDULE_ID=
FIFA_RANKING_LOCALE=en-GB
FOOTBALL_USE_ENV_PROXY=true
