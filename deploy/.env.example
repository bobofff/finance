# Application
APP_ENV=production
HTTP_PORT=8888
SKIP_AUTO_MIGRATE=false

# Database (postgres | mysql)
DB_DRIVER=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=finance
DB_PASSWORD=please-change
DB_NAME=finance
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Logging
LOG_DIR=/app/logs

# Auth (single admin user)
AUTH_USERNAME=admin
# Generate with: htpasswd -nbBC 10 "" "your-password" | tr -d ':\n'
AUTH_PASSWORD_HASH=please-change
AUTH_JWT_SECRET=please-change

# AI parsing (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=30
AI_USE_ENV_PROXY=true
