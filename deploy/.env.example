# Application
APP_ENV=production
HTTP_PORT=8888
SKIP_AUTO_MIGRATE=false

# Database (postgres | mysql)
DB_DRIVER=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=finance
DB_PASSWORD=please-change
DB_NAME=finance
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Logging
LOG_DIR=/app/logs

# Auth (single admin user)
AUTH_USERNAME=admin
# Generate with: htpasswd -nbBC 10 "" "your-password" | tr -d ':\n'
AUTH_PASSWORD_HASH=please-change
AUTH_JWT_SECRET=please-change

# AI parsing (DeepSeek official API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
AI_USE_ENV_PROXY=true

# api-football.com
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_WORLD_CUP_LEAGUE_ID=1
FOOTBALL_WORLD_CUP_SEASON=2026
FOOTBALL_USE_ENV_PROXY=true
